{
  "config": {
    "abort": {
      "single_instance_allowed": "Rootwise is already set up. Add plants with \"Add plant\"."
    },
    "step": {
      "user": {
        "description": "Rootwise keeps track of your houseplants. After setup, add each plant with \"Add plant\".",
        "title": "Set up Rootwise"
      }
    }
  },
  "config_subentries": {
    "plant": {
      "abort": {
        "merged": "Merged. Once you are happy with Rootwise, you can remove the plant from Plant Monitor.",
        "reconfigure_successful": "The plant was updated.",
        "unknown": "Something went wrong. Please start again."
      },
      "entry_type": "Plant",
      "error": {
        "no_results": "Nothing found. Try the scientific name or a shorter term.",
        "opb_failed": "OpenPlantbook did not answer. Try again in a moment, or continue without it.",
        "sensor_in_use": "This moisture sensor already belongs to another plant."
      },
      "initiate_flow": {
        "reconfigure": "Change plant",
        "user": "Add plant"
      },
      "step": {
        "basics": {
          "data": {
            "area": "Room",
            "moisture_sensor": "Soil moisture sensor",
            "name": "Name",
            "species": "Species"
          },
          "data_description": {
            "area": "Used to suggest room sensors in the next step.",
            "moisture_sensor": "The sensor in the pot. Leave empty for a plant without sensor: Rootwise then reminds you by interval. Mirror sensors (for example from Plant Monitor) are not offered: pick the real sensor, or the value disappears once Plant Monitor is gone.",
            "species": "From the built-in list; sets watering style and default thresholds. Preselected when it matches the OpenPlantbook species."
          },
          "description": "Name, room and soil sensor.",
          "title": "Plant"
        },
        "import": {
          "data": {
            "plant": "Plant"
          },
          "description": "Rootwise takes over name, room, species, picture, the real sensors and the target ranges. Plant Monitor keeps running until you remove it.",
          "title": "Import from Plant Monitor"
        },
        "merge": {
          "description": "{rootwise_plant} already uses the soil sensor of “{plant}” in Plant Monitor. Rootwise switches it to the real sensors and adds species, picture and target ranges where they are missing. Journal, thresholds, pot and your own sensor choices stay.",
          "title": "Merge into {rootwise_plant}"
        },
        "pick": {
          "data": {
            "pid": "Species"
          },
          "description": "{count} hits for “{query}”. Pick nothing to search again.",
          "title": "Pick the species"
        },
        "pot": {
          "data": {
            "drainage": "Drainage hole",
            "location": "Location",
            "pot_diameter": "Pot diameter",
            "pot_material": "Pot material",
            "window": "Window direction"
          },
          "description": "Helps with the watering amount and later with light tips.",
          "title": "Pot and location"
        },
        "ranges": {
          "data": {
            "air_humidity_max": "Air humidity maximum",
            "air_humidity_min": "Air humidity minimum",
            "conductivity_max": "Fertilizer level maximum",
            "conductivity_min": "Fertilizer level minimum",
            "illuminance_max": "Light maximum",
            "illuminance_min": "Light minimum",
            "temperature_max": "Temperature maximum",
            "temperature_min": "Temperature minimum"
          },
          "description": "Suggested by OpenPlantbook or the built-in species list. Rootwise shows a hint when a value leaves its range; only the soil moisture raises a problem. Leave a field empty for no limit.",
          "title": "Target ranges"
        },
        "reconfigure": {
          "description": "What would you like to change?",
          "menu_options": {
            "basics": "Name, room, sensors and pot",
            "search": "Species from OpenPlantbook (search or refresh)"
          },
          "title": "Change plant"
        },
        "search": {
          "data": {
            "query": "Search for"
          },
          "description": "Scientific or common name, for example “Monstera” or “Ficus lyrata”.",
          "title": "Search species"
        },
        "sensors": {
          "data": {
            "battery_sensor": "Battery",
            "conductivity_sensor": "Fertilizer level (conductivity)",
            "humidity_sensor": "Air humidity",
            "illuminance_sensor": "Light (lux)",
            "temperature_sensor": "Temperature at the plant"
          },
          "data_description": {
            "battery_sensor": "Usually the soil sensor's battery.",
            "conductivity_sensor": "Only sensors like Mi Flora measure this.",
            "humidity_sensor": "Air humidity in the room, not soil moisture.",
            "illuminance_sensor": "A lux sensor at the window. Several plants may share it. Rootwise turns it into the daily light amount (DLI) in a later version.",
            "temperature_sensor": "Best: the temperature of the soil sensor itself. Otherwise a room sensor near the plant."
          },
          "description": "Suggested from the soil sensor's device and the room. All fields are optional; remove what doesn't fit. Mirror sensors from Plant Monitor and Rootwise are not offered.",
          "title": "Further sensors"
        },
        "user": {
          "description": "How would you like to add the plant? OpenPlantbook brings a picture, names and target ranges; an import takes over a plant you already have in Plant Monitor.",
          "menu_options": {
            "basics": "Continue without OpenPlantbook",
            "import": "Import from Plant Monitor",
            "search": "Search OpenPlantbook"
          },
          "title": "Add plant"
        }
      }
    }
  },
