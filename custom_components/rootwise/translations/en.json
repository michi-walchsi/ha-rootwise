  "issues": {
    "mirror_source": {
      "fix_flow": {
        "abort": {
          "plant_removed": "This plant no longer exists."
        },
        "step": {
          "confirm": {
            "description": "Rootwise reads {plant} through sensors that only copy another sensor (for example from Plant Monitor). That delays the values and breaks as soon as the other integration is removed.\n\nRootwise switches {plant} to the real sensors:\n\n{changes}\n\nWhere it shows “?”, the source is unknown; the plant settings open so you can pick it.",
            "title": "Use the real sensors"
          }
        }
      },
      "title": "{plant} reads mirror sensors"
    }
