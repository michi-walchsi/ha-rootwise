{
  "entity": {
    "binary_sensor": {
      "needs_water": {
        "default": "mdi:water-check",
        "state": {
          "on": "mdi:water-alert"
        }
      }
    },
    "button": {
      "fertilized": {
        "default": "mdi:bottle-tonic-plus"
      },
      "snooze": {
        "default": "mdi:clock-plus-outline"
      },
      "watered": {
        "default": "mdi:watering-can"
      }
    },
    "calendar": {
      "care_calendar": {
        "default": "mdi:calendar-heart"
      }
    },
    "image": {
      "photo": {
        "default": "mdi:image-outline"
      }
    },
    "number": {
      "dry_threshold": {
        "default": "mdi:water-minus"
      },
      "watering_interval": {
        "default": "mdi:calendar-refresh"
      },
      "wet_threshold": {
        "default": "mdi:water-plus"
      }
    },
    "sensor": {
      "air_humidity": {
        "default": "mdi:water-opacity"
      },
      "conductivity": {
        "default": "mdi:sprout-outline"
      },
      "illuminance": {
        "default": "mdi:white-balance-sunny"
      },
      "last_watered": {
        "default": "mdi:watering-can"
      },
      "next_watering": {
        "default": "mdi:calendar-clock"
      },
      "plants_needing_water": {
        "default": "mdi:watering-can-outline"
      },
      "soil_moisture": {
        "default": "mdi:water-percent",
        "state_attributes": {
          "level": {
            "default": "mdi:water-percent",
            "state": {
              "dry": "mdi:water-percent-alert",
              "fresh": "mdi:water"
            }
          }
        }
      },
      "status": {
        "default": "mdi:sprout",
        "state": {
          "no_history": "mdi:sprout-outline",
          "sensor_offline": "mdi:access-point-network-off",
          "thirsty": "mdi:water-alert",
          "too_wet": "mdi:water-off"
        }
      }
    },
    "switch": {
      "vacation_mode": {
        "default": "mdi:airplane",
        "state": {
          "off": "mdi:airplane-off"
        }
      }
    },
    "todo": {
      "plant_care": {
        "default": "mdi:sprout"
      }
    }
  },
  "services": {
    "log_care": {
      "service": "mdi:notebook-edit"
    },
    "set_vacation": {
      "service": "mdi:airplane"
    },
    "snooze": {
      "service": "mdi:clock-plus-outline"
    },
    "upload_photo": {
      "service": "mdi:camera-plus-outline"
    }
  }
}
